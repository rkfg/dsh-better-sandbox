{
  "name": "@rkfg/dsh-better-sandbox",
  "version": "0.4.1",
  "type": "module",
  "description": "Sandbox rules for DeepSeek Harness: extra writable roots, write-protected path names with a narrow escalation level for them, read-protected paths.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/rules.js",
    "./bundle": "./lib/bundle.js",
    "./fs": "./lib/fs.js",
    "./escalation": "./lib/escalation.js",
    "./runner": "./lib/runner.js",
    "./subprocess": "./lib/subprocess.js",
    "./guard-api": "./lib/guard-api.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./rules": "./lib/rules.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.ru.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkfg/dsh-better-sandbox.git",
    "directory": "packages/@rkfg/dsh-better-sandbox"
  },
  "bugs": {
    "url": "https://github.com/rkfg/dsh-better-sandbox/issues"
  },
  "homepage": "https://github.com/rkfg/dsh-better-sandbox",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sandbox",
    "allowlist",
    "bubblewrap"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "rkfg <rkfg@rkfg.me>",
  "scripts": {
    "check": "bash ../../scripts/check.sh"
  }
}
